{
    "description": "Current execution pause state for a suspended thread",
    "type": "object",
    "properties": {
        "threadId": {
            "type": "string",
            "description": "ID of the suspended thread"
        },
        "threadName": {
            "type": "string",
            "description": "Name of the suspended thread"
        },
        "frames": {
            "type": "array",
            "items": {
                "description": "Information about a single stack frame",
                "type": "object",
                "properties": {
                    "frameIndex": {
                        "type": "integer",
                        "description": "0-indexed frame depth index"
                    },
                    "methodName": {
                        "type": "string",
                        "description": "Name of the method executing in this frame"
                    },
                    "declaringClass": {
                        "type": "string",
                        "description": "Fully qualified class name declaring the method"
                    },
                    "sourceFile": {
                        "type": "string",
                        "nullable": true,
                        "description": "Source file name if available"
                    },
                    "lineNumber": {
                        "type": "integer",
                        "description": "1-indexed line number in source file"
                    },
                    "coroutineContinuationObjectId": {
                        "type": "string",
                        "nullable": true,
                        "description": "Object ID of Kotlin Continuation if this frame is a coroutine"
                    }
                }
            },
            "description": "Call stack frames of the thread"
        },
        "locals": {
            "type": "array",
            "items": {
                "description": "Representation of a local variable or instance field",
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string",
                        "description": "Variable or field name"
                    },
                    "type": {
                        "type": "string",
                        "description": "Fully qualified data type name"
                    },
                    "valuePreview": {
                        "type": "string",
                        "description": "Preview string of the variable value"
                    },
                    "isPrimitive": {
                        "type": "boolean",
                        "description": "Whether the variable is a primitive"
                    },
                    "objectId": {
                        "type": "string",
                        "nullable": true,
                        "description": "Heap object ID for non-primitive reference objects"
                    }
                }
            },
            "description": "Shallow local variables in top stack frame"
        },
        "instanceVariables": {
            "type": "array",
            "items": {
                "description": "Representation of a local variable or instance field",
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string",
                        "description": "Variable or field name"
                    },
                    "type": {
                        "type": "string",
                        "description": "Fully qualified data type name"
                    },
                    "valuePreview": {
                        "type": "string",
                        "description": "Preview string of the variable value"
                    },
                    "isPrimitive": {
                        "type": "boolean",
                        "description": "Whether the variable is a primitive"
                    },
                    "objectId": {
                        "type": "string",
                        "nullable": true,
                        "description": "Heap object ID for non-primitive reference objects"
                    }
                }
            },
            "description": "Instance variables of 'this' object in top stack frame"
        }
    }
}