{
    "description": "Result of polling the asynchronous debugger event queue",
    "type": "object",
    "properties": {
        "events": {
            "type": "array",
            "items": {
                "description": "Payload describing an asynchronous debugger event",
                "type": "object",
                "properties": {
                    "eventType": {
                        "type": "string",
                        "description": "Type of event (BREAKPOINT_HIT, EXCEPTION_HIT, WATCHPOINT_HIT, DISCONNECT)"
                    },
                    "sessionId": {
                        "type": "string",
                        "description": "Session ID where the event occurred"
                    },
                    "threadId": {
                        "type": "string",
                        "nullable": true,
                        "description": "ID of thread that triggered the event"
                    },
                    "threadName": {
                        "type": "string",
                        "nullable": true,
                        "description": "Name of thread that triggered the event"
                    },
                    "location": {
                        "type": "string",
                        "nullable": true,
                        "description": "Source location where event occurred (File.kt:line)"
                    },
                    "className": {
                        "type": "string",
                        "nullable": true,
                        "description": "Fully qualified class name where event occurred"
                    },
                    "breakpointId": {
                        "type": "string",
                        "nullable": true,
                        "description": "ID of the breakpoint that was hit, if event is BREAKPOINT_HIT"
                    },
                    "exceptionMessage": {
                        "type": "string",
                        "nullable": true,
                        "description": "Message string if event is EXCEPTION_HIT"
                    },
                    "stacktrace": {
                        "type": "array",
                        "items": {
                            "description": "Information about a single stack frame",
                            "type": "object",
                            "properties": {
                                "frameIndex": {
                                    "type": "integer",
                                    "description": "0-indexed frame depth index"
                                },
                                "methodName": {
                                    "type": "string",
                                    "description": "Name of the method executing in this frame"
                                },
                                "declaringClass": {
                                    "type": "string",
                                    "description": "Fully qualified class name declaring the method"
                                },
                                "sourceFile": {
                                    "type": "string",
                                    "nullable": true,
                                    "description": "Source file name if available"
                                },
                                "lineNumber": {
                                    "type": "integer",
                                    "description": "1-indexed line number in source file"
                                },
                                "coroutineContinuationObjectId": {
                                    "type": "string",
                                    "nullable": true,
                                    "description": "Object ID of Kotlin Continuation if this frame is a coroutine"
                                }
                            }
                        },
                        "nullable": true,
                        "description": "Stack trace frames if requested during poll"
                    },
                    "timestamp": {
                        "type": "integer",
                        "description": "Epoch timestamp in milliseconds when event occurred"
                    }
                }
            },
            "description": "List of debugger events received since last poll"
        },
        "nextCursor": {
            "type": "string",
            "description": "Opaque cursor token to pass to next poll call"
        },
        "hasMore": {
            "type": "boolean",
            "description": "Whether more events remain in queue"
        }
    }
}